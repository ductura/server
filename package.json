{
  "name": "@ductura/institution-server",
  "version": "0.1.0",
  "private": true,
  "description": "Ductura zajednički API: prijava AAI@EduHr, ovlasti, baza i pozadinski poslovi",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build/server.ts",
    "start": "node --disallow-code-generation-from-strings dist/server.js",
    "stack:vs1": "node scripts/stack/vs1.ts",
    "lokalno": "node scripts/lokalno/lokalno.ts",
    "stog:gore": "node scripts/lokalno/stog.ts gore",
    "stog:dolje": "node scripts/lokalno/stog.ts dolje",
    "stog:zdravlje": "node scripts/lokalno/stog.ts zdravlje",
    "lokalno:predaje": "node scripts/lokalno/seed-predaja.ts",
    "dev:lazni-server": "node packages/test-fakes/dev-server/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ductus-tests.json",
    "lint": "eslint --flag unstable_native_nodejs_ts_config -c eslint.config.ts --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:property && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:integration": "vitest run --project integration",
    "test:equality": "vitest run --project unit server/tests/equality",
    "test:integration:pg": "vitest run --project integration-pg",
    "test:database": "vitest run --project database && pnpm test:integration:pg",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "contracts:breaking": "tsx scripts/check-breaking.ts",
    "release:stage": "node scripts/release/check.ts --stage-only",
    "release:check": "node scripts/release/check.ts",
    "release:tag": "node scripts/release/tag.ts",
    "release:tarball": "node scripts/release/tarball.ts",
    "release:level": "node scripts/release/auto.ts",
    "db:up": "docker compose up -d --build --wait postgres-main postgres-logs && pnpm db:migrate",
    "db:up:native": "node scripts/db/native-db.ts up",
    "db:provision": "docker compose exec -T postgres-main psql -U ductus -d ductus -v ON_ERROR_STOP=1 -q < db/main/local/migrator.sql",
    "db:provision:app": "docker compose exec -T postgres-main psql -U ductus -d ductus -v ON_ERROR_STOP=1 -q < db/main/local/app-login.sql",
    "db:provision:worker": "node scripts/db/provision-worker.ts",
    "db:provision:auth": "node scripts/db/provision-auth.ts",
    "db:seed": "docker compose exec -T postgres-main psql -U ductus -d ductus -v ON_ERROR_STOP=1 -q < db/main/local/seed.sql",
    "db:migrate": "pnpm db:migrate:main && pnpm db:migrate:logs && pnpm db:migrate:legal",
    "db:migrate:main": "pnpm db:provision && node scripts/db/migrate-locked.ts --url \"postgres://ductus:ductus-local-only@127.0.0.1:54329/ductus?sslmode=disable&role=ductus_migrator\" && pnpm db:provision:app && pnpm db:provision:worker && pnpm db:provision:auth",
    "db:provision:logs": "docker compose exec -T postgres-logs psql -U ductus -d ductus_logs -v ON_ERROR_STOP=1 -q < db/logs/local/migrator.sql",
    "db:migrate:logs": "pnpm db:provision:logs && node scripts/db/migrate-locked.ts --database logs --url \"postgres://ductus:ductus-logs-local-only@127.0.0.1:54330/ductus_logs?sslmode=disable&role=ductus_logs_migrator\"",
    "db:provision:legal": "docker compose exec -T postgres-main psql -U ductus -d ductus -v ON_ERROR_STOP=1 -q < db/legal/local/create-database.sql && docker compose exec -T postgres-main psql -U ductus -d ductus_legal -v ON_ERROR_STOP=1 -q < db/legal/local/migrator.sql",
    "db:migrate:legal": "pnpm db:provision:legal && node scripts/db/migrate-locked.ts --database legal --url \"postgres://ductus:ductus-local-only@127.0.0.1:54329/ductus_legal?sslmode=disable&role=ductus_legal_migrator\"",
    "test:db": "docker compose exec -T postgres-main pg_prove -U ductus -d ductus --recurse --ext .sql /db/tests",
    "test:db:main": "pg_prove --recurse --ext .sql db/main/tests",
    "test:db:logs": "node scripts/db/pgtap.ts logs",
    "test:db:legal": "node scripts/db/pgtap.ts legal",
    "test:db:native": "node scripts/db/native-db.ts test",
    "db:sum": "node scripts/db/migrations-ledger.ts --write",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@ductura/test-fakes": "workspace:*",
    "@fast-check/vitest": "0.5.0",
    "@smithy/signature-v4": "5.7.4",
    "@types/node": "^24.19.2",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "dbmate": "2.36.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "^4.10.2",
    "lefthook": "2.2.2",
    "oidc-provider": "9.12.2",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1155.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-bold": "3.33.0",
    "@tiptap/extension-document": "3.33.0",
    "@tiptap/extension-heading": "3.33.0",
    "@tiptap/extension-history": "3.33.0",
    "@tiptap/extension-italic": "3.33.0",
    "@tiptap/extension-paragraph": "3.33.0",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/extension-text": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@sinclair/typebox": "0.34.52",
    "openid-client": "6.8.8",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "uqr": "0.1.2"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/typescript-estree>minimatch": "^11.0.1"
    }
  }
}
